#!/usr/bin/env bash

set -euo pipefail

readonly search_root="${PWD}"
readonly secrets_root="${HOME}/.microsoft/usersecrets"

fail() {
    printf 'edit-user-secrets: %s\n' "$1" >&2
    exit 1
}

command -v fzf >/dev/null 2>&1 || fail "fzf no está instalado."
command -v nvim >/dev/null 2>&1 || fail "nvim no está instalado."
command -v python3 >/dev/null 2>&1 || fail "python3 no está instalado."

declare -a selected=()

mapfile -d '' -t selected < <(
    while IFS= read -r -d '' project; do
        grep -q 'UserSecretsId' "$project" || continue

        relative_path="${project#"${search_root}"/}"
        if [[ "$relative_path" == "$project" ]]; then
            relative_path="$(basename "$project")"
        fi

        printf '%s\t%s\0' "$(basename "$project" .csproj)" "$relative_path"
    done < <(
        find "$search_root" \
            \( -type d \( -name .git -o -name bin -o -name obj \) -prune \) -o \
            \( -type f -name '*.csproj' -print0 \)
    ) | fzf \
        --read0 \
        --print0 \
        --no-multi \
        --layout=reverse \
        --height=80% \
        --border \
        --delimiter=$'\t' \
        --prompt='UserSecrets project > ' \
        --header='Seleccioná un proyecto con UserSecretsId' \
        --exit-0
)

[[ ${#selected[@]} -gt 0 ]] || exit 0

selected_project="${selected[0]#*$'\t'}"
if [[ "$selected_project" != /* ]]; then
    selected_project="${search_root%/}/${selected_project}"
fi

user_secrets_id="$(python3 - "$selected_project" <<'PY'
import sys
import xml.etree.ElementTree as ET

project_path = sys.argv[1]
root = ET.parse(project_path).getroot()

for element in root.iter():
    if element.tag.rsplit("}", 1)[-1] == "UserSecretsId":
        value = (element.text or "").strip()
        if value:
            print(value)
            break
PY
)"

[[ -n "$user_secrets_id" ]] || fail "no se encontró un UserSecretsId válido en $selected_project."
[[ "$user_secrets_id" =~ ^[[:alnum:]_.-]+$ ]] || fail "el UserSecretsId contiene caracteres no permitidos."

secrets_directory="${secrets_root}/${user_secrets_id}"
secrets_file="${secrets_directory}/secrets.json"

mkdir -p "$secrets_directory"
printf 'Abriendo %s\n' "$secrets_file"
exec nvim "$secrets_file"
