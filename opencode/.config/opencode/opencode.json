{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh"
    },
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh"
    }
  },
  "default_agent": "plan",
  "autoupdate": true,
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": ["/home/exequiel/go/bin/engram", "mcp", "--tools=agent"],
      "enabled": true,
      "type": "local"
    },
    // habilitar manual solamente cuando se necesite usar
    "excalidraw": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.excalidraw.com"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  }
}
